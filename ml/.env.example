# Copy to .env and change the secrets. Never commit .env.

# Versions (keep in sync with versions.yaml)
MLFLOW_VERSION=v3.17.2
RUSTFS_VERSION=1.0.0-alpha.83
RC_VERSION=latest

# PostgreSQL (MLflow backend store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mlflow

# RustFS (MLflow artifact store)
RUSTFS_ACCESS_KEY=mlflow-access
RUSTFS_SECRET_KEY=change-me-rustfs-secret
MLFLOW_BUCKET=mlflow

# MLflow server
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
