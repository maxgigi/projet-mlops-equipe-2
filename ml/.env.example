# Copy to .env and change the secrets. Never commit .env.

# Versions (keep in sync with versions.yaml; see ADR-003 and ADR-004)
MLFLOW_VERSION=v3.17.2
POSTGRES_VERSION=16.15
RUSTFS_VERSION=1.0.6
RC_VERSION=v0.1.37

# PostgreSQL (MLflow backend store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mlflow

# RustFS (MLflow artifact store)
RUSTFS_ACCESS_KEY=mlflow-access
RUSTFS_SECRET_KEY=change-me-rustfs-secret
MLFLOW_BUCKET=mlflow

# MLflow server
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
# 2 workers: ~560 MiB at idle instead of ~2.3 GiB with the defaults (measured 18/11)
MLFLOW_WORKERS=2
