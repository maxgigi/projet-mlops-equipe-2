# Copier en secret.env (ignoré par Git) et changer les valeurs.
# Mot de passe PostgreSQL : sans caractères spéciaux d'URL (@ : / ? #),
# il est inséré tel quel dans l'URI de connexion de MLflow.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mlflow
RUSTFS_ACCESS_KEY=mlflow-access
RUSTFS_SECRET_KEY=change-me-rustfs-secret
