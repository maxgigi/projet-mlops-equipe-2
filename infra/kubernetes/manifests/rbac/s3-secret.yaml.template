# Pour P4 : Secret S3 (RustFS) lié à sa-models. Remplir les variables, ne PAS versionner la version remplie.
# cp s3-secret.yaml.template s3-secret.yaml ; kubectl apply -f s3-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: s3-rustfs
  namespace: models
  annotations:
    serving.kserve.io/s3-endpoint: "A_REMPLIR_ENDPOINT_RUSTFS"      # ex. rustfs.mlops.svc:9000
    serving.kserve.io/s3-usehttps: "0"
    serving.kserve.io/s3-region: "us-east-1"
    serving.kserve.io/s3-useanoncredential: "false"
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "A_REMPLIR"
  AWS_SECRET_ACCESS_KEY: "A_REMPLIR"
---
apiVersion: v1
kind: ServiceAccount
metadata: { name: sa-models, namespace: models }
secrets:
  - name: s3-rustfs
